    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOYA Files shows and organizes the files on your Desktop."
          }
        },
        "fr": {
          "stringUnit": {
